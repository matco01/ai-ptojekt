# Copy to .env.local and fill in. Get a key at https://platform.claude.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional
# MODEL=claude-opus-5          # which Claude model the salesperson uses
# EFFORT=low                   # low | medium | high – higher = smarter but slower/costlier
# PORT=3000
# ADMIN_TOKEN=change-me        # protects the dashboard API; open /admin/?token=change-me
# ALLOWED_ORIGIN=*             # which websites may embed the widget (CORS)
