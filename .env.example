# Copy to .env.local and fill in. Get a key at https://platform.claude.com/
ANTHROPIC_API_KEY=sk-ant-...

# Database (Supabase → Project Settings → API). Without these, data goes to local files.
# Run supabase/schema.sql in the Supabase SQL Editor (again after every update).
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...   # server-only full-access key – never put it in the widget

# Required in production
# ADMIN_TOKEN=long-random-password     # your login to every dashboard: ID "admin" + this password (/admin/)
# CRON_SECRET=long-random-string       # Vercel sends it to /api/cron/daily (clean-up, feed checks)

# Payments (Stripe) – shops that sign up on the Sella site pay their plan by card. See README → "Registrace a platby".
# Without a key, payments are simulated locally and switched off on a server.
# STRIPE_SECRET_KEY=sk_live_...          # Stripe → Developers → API keys (sk_test_... for testing)
# STRIPE_WEBHOOK_SECRET=whsec_...        # Stripe → Developers → Webhooks → endpoint https://YOUR-SITE/api/stripe/webhook
# STRIPE_TRIAL_DAYS=0                    # free days before the first charge (card is entered right away)
# PAYMENTS=demo                          # TESTING ONLY: a new sign-up counts as paid at once, no card. Never with real customers.

# E-mails to shop owners (Resend): confirming the address at sign-up and "Forgot your password?".
# Without a key no e-mail is sent: sign-ups aren't confirmed and the password page points to the contact e-mail.
# RESEND_API_KEY=re_...                  # resend.com → API Keys; verify the sending domain (sella.chat) under Domains first
# MAIL_FROM=Sella <noreply@sella.chat>   # the sender – must be on the verified domain
# SITE_URL=https://sella.chat            # where links in e-mails lead (on Vercel production this is the default)

# Recommended
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...   # Slack or Discord webhook: errors, broken feeds, clients near their limit
# SESSION_SECRET=long-random-string    # signs dashboard logins; defaults to one derived from ADMIN_TOKEN

# Optional
# MODEL=claude-haiku-5-5       # which Claude model the salesperson uses (claude-sonnet-5-5 = smarter, 20× dearer)
# EFFORT=medium                # low | medium | high – higher = smarter but slower/costlier
# RETENTION_DAYS=90            # how long visitor events and chat questions are kept
# PORT=3000

# Natural voice (optional). Without it the browser's built-in voice is used.
# Azure AI Speech: portal.azure.com → Create a resource → Speech → Keys and Endpoint (≈ $16 per million characters;
# the Free F0 tier has 500 000 characters a month but only 20 requests a minute – use Standard S0 for real traffic)
# AZURE_SPEECH_KEY=...
# AZURE_SPEECH_REGION=westeurope
# AZURE_VOICE_CS_F=cs-CZ-VlastaNeural      # optional: other voices (CS_M, EN_F, EN_M) from Azure's voice list
