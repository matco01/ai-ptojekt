# Copy to .env.local and fill in. Get a key at https://platform.claude.com/
ANTHROPIC_API_KEY=sk-ant-...

# Database (Supabase → Project Settings → API). Without these, data goes to local files.
# Run supabase/schema.sql in the Supabase SQL Editor (again after every update).
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...   # server-only full-access key – never put it in the widget

# Required in production
# ADMIN_TOKEN=long-random-password     # your login to every dashboard: ID "admin" + this password (/admin/)
# CRON_SECRET=long-random-string       # Vercel sends it to /api/cron/daily (clean-up, feed checks)

# Recommended
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...   # Slack or Discord webhook: errors, broken feeds, clients near their limit
# SESSION_SECRET=long-random-string    # signs dashboard logins; defaults to one derived from ADMIN_TOKEN

# Optional
# MODEL=claude-haiku-5-5       # which Claude model the salesperson uses (claude-sonnet-5-5 = smarter, 20× dearer)
# EFFORT=medium                # low | medium | high – higher = smarter but slower/costlier
# RETENTION_DAYS=90            # how long visitor events and chat questions are kept
# PORT=3000

# Natural voice (optional). Without it the browser's built-in voice is used.
# Free key at https://elevenlabs.io → Profile → API key (free tier ≈ 10 000 characters / month)
# ELEVENLABS_API_KEY=sk_...
# ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9   # "Jessica" – young, playful; any voice from the ElevenLabs library works
# ELEVENLABS_MODEL=eleven_multilingual_v2    # best Czech; eleven_turbo_v2_5 = faster start
